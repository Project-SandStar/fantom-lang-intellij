<idea-plugin>
    <!-- Loaded only when the Java plugin is present (com.intellij.java): the JVM debugger for .fan files.
         Every class registered here lives in co.anbora.labs.fantom.ide.debugger; nothing else imports it. -->
    <extensions defaultExtensionNs="com.intellij">
        <programRunner implementation="co.anbora.labs.fantom.ide.debugger.FantomDebugRunner"/>
        <debugger.javaDebugAware implementation="co.anbora.labs.fantom.ide.debugger.FantomJavaDebugAware"/>
        <debugger.positionManagerFactory implementation="co.anbora.labs.fantom.ide.debugger.FantomPositionManagerFactory"/>
        <debugger.extraSteppingFilter implementation="co.anbora.labs.fantom.ide.debugger.FantomClosureSteppingFilter"/>
        <debuggerClassFilterProvider implementation="co.anbora.labs.fantom.ide.debugger.FantomDebuggerClassFilterProvider"/>
        <!-- Evaluate Expression, Watches and breakpoint conditions in .fan frames: ide.debugger.eval -->
        <debugger.codeFragmentFactory implementation="co.anbora.labs.fantom.ide.debugger.eval.FantomCodeFragmentFactory"/>
        <!-- java.base in scope when no module has a Java SDK, so the platform's List and Map renderers apply -->
        <additionalLibraryRootsProvider implementation="co.anbora.labs.fantom.ide.debugger.FantomJdkRootsProvider"/>
        <java.elementFinder implementation="co.anbora.labs.fantom.ide.debugger.FantomJdkClassFinder"/>
    </extensions>
</idea-plugin>
