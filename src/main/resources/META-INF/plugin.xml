<idea-plugin>
    <id>org.project-sandstar.fantom-lang</id>
    <name>Project Sandstar Fantom</name>
    <vendor email="info@project-sandstar.org" url="https://project-sandstar.org">Project Sandstar</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.platform.testRunner</depends>
    <depends optional="true" config-file="fantom-spellchecker.xml">com.intellij.modules.spellchecker</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Fantom" implementationClass="co.anbora.labs.fantom.lang.FantomFileType"
                  fieldName="INSTANCE" language="fantom_lang" extensions="fan"/>
        <!-- 2026.3+: declarative registration; com.intellij.colorSettingsPage is deprecated since 263 -->
        <colorSettings implementation="co.anbora.labs.fantom.ide.color.FantomColorSettingPage"
                       displayName="Fantom"/>
        <!-- Default colours for keys the platform leaves plain (operators, braces, locals, params, calls) -->
        <additionalTextAttributes scheme="Default" file="colorSchemes/FantomDefault.xml"/>
        <additionalTextAttributes scheme="Light" file="colorSchemes/FantomLight.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/FantomDarcula.xml"/>
        <additionalTextAttributes scheme="Dark" file="colorSchemes/FantomDark.xml"/>

        <lang.parserDefinition language="fantom_lang"
                               implementationClass="co.anbora.labs.fantom.lang.FantomParserDefinition"/>
        <lang.commenter language="fantom_lang" implementationClass="co.anbora.labs.fantom.ide.commenter.FantomCommenter"/>
        <lang.syntaxHighlighterFactory language="fantom_lang"
                                       implementationClass="co.anbora.labs.fantom.ide.highlight.FantomSyntaxHighlighterFactory"/>
        <lang.braceMatcher language="fantom_lang" implementationClass="co.anbora.labs.fantom.ide.typing.FantomBraceMatcher"/>
        <lang.quoteHandler language="fantom_lang" implementationClass="co.anbora.labs.fantom.ide.typing.FantomQuoteHandler"/>
        <typedHandler implementation="co.anbora.labs.fantom.ide.typing.FantomTypedHandler"/>
        <enterHandlerDelegate implementation="co.anbora.labs.fantom.ide.typing.FantomEnterHandler" order="first"/>
        <backspaceHandlerDelegate implementation="co.anbora.labs.fantom.ide.typing.FantomBackspaceHandler"/>
        <lang.foldingBuilder language="fantom_lang" implementationClass="co.anbora.labs.fantom.ide.folding.FantomFoldingBuilder"/>
        <lang.formatter language="fantom_lang" implementationClass="co.anbora.labs.fantom.ide.formatter.FantomFormattingModelBuilder"/>
        <langCodeStyleSettingsProvider implementation="co.anbora.labs.fantom.ide.formatter.FantomLanguageCodeStyleSettingsProvider"/>
        <lang.psiStructureViewFactory language="fantom_lang"
                                      implementationClass="co.anbora.labs.fantom.ide.structure.FantomStructureViewFactory"/>
        <lang.findUsagesProvider language="fantom_lang" implementationClass="co.anbora.labs.fantom.ide.usages.FantomFindUsagesProvider"/>
        <!-- Ctrl+Alt+O: drop unused `using` lines and sort the rest -->
        <lang.importOptimizer language="fantom_lang" implementationClass="co.anbora.labs.fantom.ide.imports.FantomImportOptimizer"/>
        <localInspection language="fantom_lang" shortName="FantomUnusedUsing" displayName="Unused using"
                         groupName="Fantom" enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="co.anbora.labs.fantom.ide.inspections.FantomUnusedUsingInspection"/>
        <lang.documentationProvider language="fantom_lang" implementationClass="co.anbora.labs.fantom.ide.documentation.FantomDocumentationProvider"/>
        <codeInsight.parameterInfo language="fantom_lang" implementationClass="co.anbora.labs.fantom.ide.parameters.FantomParameterInfoHandler"/>
        <!-- Alt+Insert: Override Methods (virtual and abstract slots), Implement Methods (abstract only) -->
        <codeInsight.overrideMethod language="fantom_lang" implementationClass="co.anbora.labs.fantom.ide.generate.FantomOverrideMethodsHandler"/>
        <codeInsight.implementMethod language="fantom_lang" implementationClass="co.anbora.labs.fantom.ide.generate.FantomImplementMethodsHandler"/>
        <!-- Gutter: overriding arrow on `override` slots, overridden arrow on virtual/abstract slots with project overrides -->
        <codeInsight.lineMarkerProvider language="fantom_lang" implementationClass="co.anbora.labs.fantom.ide.generate.FantomOverrideLineMarkerProvider"/>
        <!-- Inferred type after `x := ...` locals and untyped closure params, like Kotlin's type hints -->
        <codeInsight.declarativeInlayProvider language="fantom_lang"
                                              implementationClass="co.anbora.labs.fantom.ide.hints.FantomTypeHintsProvider"
                                              isEnabledByDefault="true" group="TYPES_GROUP" providerId="fantom.types"
                                              bundle="messages.FantomBundle"
                                              nameKey="inlay.fantom.types.name" descriptionKey="inlay.fantom.types.description"/>
        <!-- Parameter names before call arguments, like Kotlin and Java; same settings node as the type hints -->
        <codeInsight.declarativeInlayProvider language="fantom_lang"
                                              implementationClass="co.anbora.labs.fantom.ide.hints.FantomParameterHintsProvider"
                                              isEnabledByDefault="true" group="TYPES_GROUP" providerId="fantom.parameters"
                                              bundle="messages.FantomBundle"
                                              nameKey="inlay.fantom.parameters.name" descriptionKey="inlay.fantom.parameters.description"/>
        <!-- Ctrl+Space: slots of the receiver type, names in scope, types, keywords -->
        <completion.contributor language="fantom_lang" implementationClass="co.anbora.labs.fantom.ide.completion.FantomCompletionContributor"/>
        <!-- Live templates (main, if, for, each, ...) and postfix templates (expr.if, .not, .each, .echo, .var, ...) -->
        <liveTemplateContext contextId="FANTOM" implementation="co.anbora.labs.fantom.ide.templates.FantomTemplateContextType"/>
        <defaultLiveTemplates file="/liveTemplates/Fantom.xml"/>
        <codeInsight.template.postfixTemplateProvider language="fantom_lang"
                                                      implementationClass="co.anbora.labs.fantom.ide.templates.FantomPostfixTemplateProvider"/>
        <lang.refactoringSupport language="fantom_lang" implementationClass="co.anbora.labs.fantom.ide.refactoring.FantomRefactoringSupportProvider"/>
        <lang.namesValidator language="fantom_lang" implementationClass="co.anbora.labs.fantom.ide.refactoring.FantomNamesValidator"/>

        <fileBasedIndex implementation="co.anbora.labs.fantom.lang.index.FantomDeclarationIndex"/>
        <!-- Fantom install sources as a library, so sys names resolve from any project -->
        <additionalLibraryRootsProvider implementation="co.anbora.labs.fantom.lang.library.FantomLibraryRootsProvider"/>
        <!-- Settings | Languages & Frameworks | Fantom: pick the Fantom home -->
        <projectConfigurable parentId="language" instance="co.anbora.labs.fantom.ide.settings.FantomConfigurable"
                             id="co.anbora.labs.fantom.settings" displayName="Fantom" nonDefaultProject="true"/>
        <postStartupActivity implementation="co.anbora.labs.fantom.ide.settings.FantomHomeStartupActivity"/>
        <notificationGroup id="Fantom" displayType="BALLOON"/>
        <gotoClassContributor implementation="co.anbora.labs.fantom.ide.navigation.FantomGotoClassContributor"/>
        <gotoSymbolContributor implementation="co.anbora.labs.fantom.ide.navigation.FantomGotoSymbolContributor"/>

        <annotator language="fantom_lang"
                   implementationClass="co.anbora.labs.fantom.ide.annotator.HighlightingAnnotator"/>
        <!-- Inspections -->
        <localInspection language="fantom_lang" shortName="FantomUnresolvedReference" displayName="Unresolved reference"
                         groupName="Fantom" enabledByDefault="true" level="WARNING"
                         implementationClass="co.anbora.labs.fantom.ide.inspections.FantomUnresolvedReferenceInspection"/>
        <localInspection language="fantom_lang" shortName="FantomUnusedDeclaration" displayName="Unused declaration"
                         groupName="Fantom" enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="co.anbora.labs.fantom.ide.inspections.FantomUnusedDeclarationInspection"/>
        <localInspection language="fantom_lang" shortName="FantomNullableReceiver" displayName="Nullable receiver"
                         groupName="Fantom" enabledByDefault="true" level="WARNING"
                         implementationClass="co.anbora.labs.fantom.ide.inspections.FantomNullableReceiverInspection"/>
        <!-- Run: `fan pod::Type.main` / `fan script.fan` and `fant pod[::Class[.method]]`, with gutter arrows -->
        <configurationType implementation="co.anbora.labs.fantom.ide.run.FantomRunConfigurationType"/>
        <runConfigurationProducer implementation="co.anbora.labs.fantom.ide.run.FantomRunConfigurationProducer"/>
        <runConfigurationProducer implementation="co.anbora.labs.fantom.ide.run.FantomTestRunConfigurationProducer"/>
        <runLineMarkerContributor language="fantom_lang" implementationClass="co.anbora.labs.fantom.ide.run.FantomRunLineMarkerContributor"/>
        <!-- Compiler diagnostics: `fan build.fan compile` on save, messages painted in the editor -->
        <externalAnnotator language="fantom_lang" implementationClass="co.anbora.labs.fantom.ide.compiler.FantomCompilerAnnotator"/>
        <!-- Editor basics: type declaration, implementations, breadcrumbs, TODO -->
        <typeDeclarationProvider implementation="co.anbora.labs.fantom.ide.navigation.FantomTypeDeclarationProvider"/>
        <definitionsScopedSearch implementation="co.anbora.labs.fantom.ide.navigation.FantomImplementationSearch"/>
        <breadcrumbsInfoProvider implementation="co.anbora.labs.fantom.ide.structure.FantomBreadcrumbsProvider"/>
        <indexPatternBuilder implementation="co.anbora.labs.fantom.ide.todo.FantomIndexPatternBuilder"/>
        <!-- Compiled pods without sources: .fan stubs from the pod's apidoc -->
        <postStartupActivity implementation="co.anbora.labs.fantom.lang.pod.FantomPodStubActivity"/>
        <!-- Axon language (.axon), injected in Fantom strings and trio src: values -->
        <fileType name="Axon" implementationClass="co.anbora.labs.fantom.lang.axon.AxonFileType"
                  fieldName="INSTANCE" language="axon_lang" extensions="axon"/>
        <lang.parserDefinition language="axon_lang" implementationClass="co.anbora.labs.fantom.lang.axon.AxonParserDefinition"/>
        <lang.syntaxHighlighterFactory language="axon_lang" implementationClass="co.anbora.labs.fantom.ide.axon.AxonSyntaxHighlighterFactory"/>
        <lang.braceMatcher language="axon_lang" implementationClass="co.anbora.labs.fantom.ide.axon.AxonBraceMatcher"/>
        <lang.commenter language="axon_lang" implementationClass="co.anbora.labs.fantom.ide.axon.AxonCommenter"/>
        <colorSettings implementation="co.anbora.labs.fantom.ide.axon.AxonColorSettingsPage" displayName="Axon"/>
        <multiHostInjector implementation="co.anbora.labs.fantom.ide.axon.AxonInjector"/>
        <!-- Trio (.trio) -->
        <fileType name="Trio" implementationClass="co.anbora.labs.fantom.lang.trio.TrioFileType"
                  fieldName="INSTANCE" language="trio_lang" extensions="trio"/>
        <lang.parserDefinition language="trio_lang" implementationClass="co.anbora.labs.fantom.lang.trio.TrioParserDefinition"/>
        <lang.syntaxHighlighterFactory language="trio_lang" implementationClass="co.anbora.labs.fantom.lang.trio.TrioSyntaxHighlighterFactory"/>
        <!-- Fandoc (.fandoc) -->
        <fileType name="Fandoc" implementationClass="co.anbora.labs.fantom.lang.fandoc.FandocFileType"
                  fieldName="INSTANCE" language="fandoc_lang" extensions="fandoc"/>
        <lang.parserDefinition language="fandoc_lang" implementationClass="co.anbora.labs.fantom.lang.fandoc.FandocParserDefinition"/>
        <lang.syntaxHighlighterFactory language="fandoc_lang" implementationClass="co.anbora.labs.fantom.lang.fandoc.FandocSyntaxHighlighterFactory"/>
        <!-- fan.props and etc/**/*.props (matched by FanPropsFileType.isMyFileType) -->
        <fileType name="Fantom props" implementationClass="co.anbora.labs.fantom.lang.props.FanPropsFileType"
                  fieldName="INSTANCE" language="fan_props" fileNames="fan.props"/>
        <lang.parserDefinition language="fan_props" implementationClass="co.anbora.labs.fantom.lang.props.FanPropsParserDefinition"/>
        <lang.syntaxHighlighterFactory language="fan_props" implementationClass="co.anbora.labs.fantom.lang.props.FanPropsSyntaxHighlighterFactory"/>
        <lang.commenter language="fan_props" implementationClass="co.anbora.labs.fantom.lang.props.FanPropsCommenter"/>
    </extensions>
    <applicationListeners>
        <listener class="co.anbora.labs.fantom.ide.compiler.FantomCompileOnSaveListener"
                  topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
    </applicationListeners>
    <projectListeners>
        <listener class="co.anbora.labs.fantom.ide.compiler.FantomCompileOnOpenListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <actions>
        <action id="Fantom.NewFantomClass"
                class="co.anbora.labs.fantom.ide.actions.CreateNewClassAction"
                text="Fantom Class"
                description="Create new Fantom class">
        </action>
    </actions>
</idea-plugin>
