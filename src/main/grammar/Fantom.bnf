{
    parserClass="co.anbora.labs.fantom.lang.core.parser.FantomParser"
    psiClassPrefix="Fantom"
    psiImplClassSuffix="Impl"

    implements="co.anbora.labs.fantom.lang.core.psi.FantomElement"
    extends="co.anbora.labs.fantom.lang.core.psi.FantomElementImpl"

    psiPackage="co.anbora.labs.fantom.lang.core.psi"
    psiImplPackage="co.anbora.labs.fantom.lang.core.psi.impl"
    parserUtilClass="co.anbora.labs.fantom.lang.core.FantomParserUtil"

    elementTypeHolderClass="co.anbora.labs.fantom.lang.core.psi.FantomTypes"

    elementTypeClass="co.anbora.labs.fantom.lang.core.FantomElementType"
    tokenTypeClass="co.anbora.labs.fantom.lang.core.FantomTokenType"

    extends(".*Stm")=stmt

    // Named declarations: one mixin gives getName/setName/getNameIdentifier.
    // The pattern must list both interfaces because it replaces the global `implements`.
    mixin("classDef|mixinDef|facetDef|enumDef|enumValDef|fieldDef|methodDef|ctorDef|param|localDef|closureParam|catchDef")="co.anbora.labs.fantom.lang.core.psi.impl.FantomNamedElementImpl"
    implements("classDef|mixinDef|facetDef|enumDef|enumValDef|fieldDef|methodDef|ctorDef|param|localDef|closureParam|catchDef")=[
        "co.anbora.labs.fantom.lang.core.psi.FantomElement"
        "co.anbora.labs.fantom.lang.core.psi.FantomNamedElement"
    ]

    // Identifier uses carry a PsiReference (declaration names do not, see FantomIdMixin).
    mixin("id")="co.anbora.labs.fantom.lang.core.psi.impl.FantomIdMixin"

    tokens = [

        GET                 = 'get_kw'
        SET                 = 'set_kw'
        ENUM                = 'enum_kw'
        FACET               = 'facet_kw'

        IT                  = 'it'
        ASSERT              = 'assert'
        DO                  = 'do'
        FOREACH             = 'foreach'
        VOID                = 'void'
        VOLATILE            = 'volatile'

        OR                  = '|'
        LPAR                = '('
        RPAR                = ')'
        LBRACE              = '{'
        RBRACE              = '}'
        LBRACKET            = '['
        RBRACKET            = ']'

        DOT                 = '.'
        RANGE_SEP_INCL      = '..'
        RANGE_SEP_EXCL      = '..<'
        DYN_CALL            = '->'
        SAFE_DOT            = '?.'
        SAFE_DYN_CALL       = '?->'

        EQ                  = '='

        SEMICOLON           = ';'
        COMMA               = ','

        COLON_COLON         = '::'
        COLON               = ':'
        SHARP               = '#'
        AT                  = "@"
        QUEST               = "?"
        QUEST_COLON         = "?:"
        COLON_EQ            = ':='
        EQEQ                = "=="
        NE                  = "!="
        EQEQEQ              = "==="
        NEEQ                = "!=="

        LT                  = "<"
        GT                  = ">"
        LE                  = "<="
        GE                  = ">="
        COMPARE             = "<=>"
        PLUS                = "+"
        MINUS               = "-"
        MULT                = "*"
        PERC                = "%"
        PLUSPLUS            = "++"
        MINUSMINUS          = "--"
        LTLT                = "<<"
        GTGT                = ">>"
        AND                 = "&"
        XOR                 = "^"
        EXCL                = "!"
        TILDE               = "~"
        ANDAND              = "&&"
        OROR                = "||"
        PLUSEQ              = "+="
        MINUSEQ             = "-="
        MULTEQ              = "*="
        PERCEQ              = "%="
        LTLTEQ              = "<<="
        GTGTEQ              = ">>="
        ANDEQ               = "&="
        OREQ                = "|="
        XOREQ               = "^="
        DIV                 = "/"
        DIVEQ               = "/="

    ]

}

// SHABENG and FANDOC_LINE_COMMENT are comment tokens, so the parser skips them
// anywhere. `doc` stays for the day doc comments become real PSI.
compilationUnit ::=  usingDef* (typeDef | doc)*
usingDef          ::=  usingPod //| usingType | usingAs
// Compiler skipUsing: using (str | [ffi] id (. id)*) [:: id ($ [id])* [as id]] eos.
// `$` is a Java identifier char, so `Line2D$Double` is one IDENTIFIER token.
usingPod        ::=  using podSpec ['::' id [as id]] [";"] {pin=1}
//usingType       ::=  using podSpec '::' id
//usingAs         ::=  using podSpec '::' id as id
podSpec         ::=  id ("." id)* | str | ffiPodSpec
ffiPodSpec      ::= "[" id "]" id ("." id)*
doc             ::= FANDOC_LINE_COMMENT
//------------

typeDef        ::=  classDef | mixinDef | facetDef | enumDef

classDef                    ::=  typeHeader class id [inheritance] highOrderBlock {pin=2}
highOrderBlock              ::=  "{" slotDefs "}" { pin = 1 }

mixinDef       ::=  typeHeader mixin id [inheritance] highOrderBlock {pin=2}
facetDef       ::=  typeHeader <<facetKeyword>> class id [inheritance] highOrderBlock {pin=2}
enumDef        ::=  typeHeader <<enumKeyword>> class id [inheritance] enumBlock {pin=2}
enumBlock      ::=  "{" enumValDefs slotDefs "}" {pin=1}

typeHeader     ::=  [doc] facets typeFlags
typeFlags      ::=  typeFlag*
typeFlag       ::=  protection | abstract | final | const | native
protection     ::=  public | protected | private | internal
inheritance    ::=  ":" typeList

//------------

//enumValDefs    ::=  enumValDef ("," enumValDef)* [";"]
//enumValDef     ::=  facets id ["(" args ")"]

// Compiler: enumDef ("," enumDef)* endOfStmt. Only a comma continues the list.
enumValDefs    ::=  enumValDef (',' enumValDef)* [";"]
enumValDef     ::=  facets id ["(" args ")"]


slotDefs       ::=  slotDef*
slotDef        ::=  !('}' | <<eof>>) slotDef_item {
    pin=1
    recoverWhile=class_item_recover
}
private class_item_first ::= methodFlag | typeFlag | protection
// `[` and `|` start map and func types, so they can start a slot.
private class_item_recover ::= !('}' | <<eof>> | "@" | class_item_first | new | IDENTIFIER | "[" | "|")
// Compiler slotDef: `static {` is a static init; then facets and flags; a `new`
// flag means ctor; else `type id` and `(` means method, else field.
private slotDef_item ::= staticInit
                        | ctorDef
                        | methodDef
                        | fieldDef

// Compiler fieldDef: facets flags type id [":=" expr]
//   ["{" getOrSet getOrSet "}"] eos.
// Abstract, static and const fields in mixins have no init: `abstract Bool i`.
fieldDef       ::=  facets fieldFlags type id [":=" expr]
                     [ fieldDefBlock ] [";"]

// getOrSet: `[flags] (get | set) (block | eos)`, at most once each, any order.
fieldDefBlock  ::=  "{" fieldAccessor* "}" {pin=1}
private fieldAccessor ::= !("}" | <<eof>>) (fieldGetter | fieldSetter) {
    pin=1
    recoverWhile=field_item_recover
}
private field_item_recover ::= !("}" | <<eof>> | get | set | fieldFlag)

fieldFlags     ::=  fieldFlag*
fieldFlag      ::=  protection | abstract | const | final | native |
                     override | readonly | static | virtual
fieldGetter    ::=  fieldFlags get [statementBlock | ";"] {pin=2}
fieldSetter    ::=  fieldFlags set [statementBlock | ";"] {pin=2}

// Compiler methodDef: abstract and native methods have no body and end with
// eos; `once Str bar() { "a" }` and `virtual Void g() {}` have a block.
methodDef          ::=  facets methodFlags type id itemParameterList [statementBlock] [";"] {pin=5}
itemParameterList  ::=  "(" params* ")" {pin=1}

methodFlags    ::=  methodFlag*
methodFlag     ::=  protection | abstract | native | once |
                     override | static | virtual | final
params         ::=  !(')' | '{' | ';') [param] (',' | &')')
{
    pin=1
    recoverWhile=params_recover
}
private params_recover ::= !(')' | '{' | ';' | type)

param          ::=  type id [":=" expr]
statementBlock      ::=  "{" stmts "}"
{
    pin=1
}

// Body is optional: sys pod ctors are implicitly native (`protected new make()`).
ctorDef        ::=  facets ctorFlags [static] new id itemParameterList [ctorChain] [statementBlock] [";"]
ctorFlags      ::=  [protection]
ctorChain      ::=  ":" (ctorChainThis | ctorChainSuper)
ctorChainThis  ::=  this "." id "(" args ")"
ctorChainSuper ::=  super ["." id] "(" args ")"

staticInit     ::=  static statementBlock

//--------------

// Compiler facets: `"@" ctype ["{" (id "=" expr eos)* "}"]`. Values are
// separated by `;` or a newline. Keep `simpleType` here: the annotator colors
// a FantomSimpleType under FantomFacetItems as an annotation.
facets        ::= facetItems*
facetItems    ::= "@" simpleType [facetVals] {pin=1}
facetVals     ::= "{" facetVal* "}" {pin=1}
facetVal      ::= !("}" | <<eof>>) id "=" expr [";"] {
    pin=2
    recoverWhile=facetVal_recover
}
private facetVal_recover ::= !("}" | <<eof>> | IDENTIFIER)

//-------------

block          ::=  stmt | statementBlock
stmts            ::=  stmtDef*
private stmtDef          ::=  !('}' | <<eof>>) stmt
{
    pin=1
    recoverWhile=stmt_item_recover
}
private stmt_item_recover ::= !('}' | <<eof>> | "@" | break
                                    | continue | for | if | return
                                    | throw | while | try | catch
                                    | finally | switch | case
                                    | default | this | super | it
                                    | IDENTIFIER | stmt_start_token)
// Grammar-Kit runs recoverWhile after every stmtDef, success or not, and eats
// tokens until one in this set. So the set must hold every token that can
// start a statement, or `++i`, `&f = 1`, `(2..4).each`, `-x.abs` lose their
// first token.
private stmt_start_token ::= "(" | "[" | "++" | "--" | "!" | "-" | "+" | "&" | "|" | "#"
                           | null | TRUE | FALSE
                           | INT_LITERAL | FLOAT_LITERAL | DECIMAL_LITERAL | DURATION_LITERAL
                           | URI_LITERAL | STRING_LITERAL | TRIPLE_STRING_LITERAL | CHAR_LITERAL

stmt             ::=  breakStm | continueStm | forStm | ifStm | returnStm | switchStm |
                     throwStm | whileStm | tryStm | exprStmt
breakStm         ::=  break [";"]
continueStm      ::=  continue [";"]
forStm           ::=  for "(" [forInit] ";" [expr] ";" [expr] ")" block
forInit        ::=  localDef | expr
ifStm            ::=  if "(" expr ")" block [ else block ]
returnStm        ::=  return [<<sameLine>> expr] [";"]
throwStm         ::=  throw expr [";"]
whileStm         ::=  while "(" expr ")" block
exprStmt       ::=  localDef [";"] | expr [itAdd] [";"]
localDef       ::=  localDefBlock
private localDefBlock ::= type id ":=" expr | id ":=" expr | type id &<<eos>>
// it.add sugar: `a, b, c` inside an it-block. Also a lone trailing comma.
itAdd          ::=  ("," expr)+ [","] | ","

tryStm           ::=  try block catchStm* [finallyStm]
catchStm         ::=  catch [catchDef] block
catchDef       ::=  "(" type id ")"
finallyStm       ::=  finally block

// Compiler switchStmt: `{ (("case" expr ":")+ stmts | "default" ":" stmts)* }`.
// Several `case` labels in a row share one block. `case`/`default` are not
// statements, so `stmts` stops at them through stmt_item_recover.
switchStm        ::=  switch "(" expr ")" switchStmBlock
switchStmBlock   ::=  "{" switchEntry* "}" { pin=1 }
private switchEntry ::= !("}" | <<eof>>) (caseBlock | defaultBlock) {
    pin=1
    recoverWhile=switchEntry_recover
}
private switchEntry_recover ::= !("}" | <<eof>> | case | default)

caseBlock        ::=  caseLabel+ switchStmts
// `case opPing: pong()` must not read `opPing: pong` as a map type, so a bare
// `id :` label is taken before the general expr form.
caseLabel        ::=  case (caseIdLabel | expr ":") {pin=1}
private caseIdLabel ::= &(IDENTIFIER ":") local ":"
defaultBlock     ::=  default ":" switchStmts {pin=1}
// Like `stmts`, but a `case` or `default` label ends the list without an error.
private switchStmts   ::=  switchStmtDef*
private switchStmtDef ::=  !('}' | <<eof>> | case | default) stmt
{
    pin=1
    recoverWhile=stmt_item_recover
}

//------------

expr           ::=  assignExpr
assignExpr     ::=  ifExpr [assignOp assignExpr]
assignOp       ::=  "=" | "*=" | "/=" | "%=" | "+=" | "-="

ifExpr           ::=  condOrExpr ["?:" ifExprBody | "?" ifExprBody ":" ifExprBody]
//ternaryExpr      ::=  condOrExpr ["?" ifExprBody ":" ifExprBody]
//elvisExpr        ::=  condOrExpr "?:" ifExprBody
ifExprBody     ::=  condOrExpr | ifExprThrow
ifExprThrow    ::=  throw expr

condOrExpr     ::=  condAndExpr  ("||" condAndExpr)*
condAndExpr    ::=  equalityExpr ("&&" equalityExpr)*
equalityExpr   ::=  relationalExpr [("==" | "!=" | "===" | "!==") relationalExpr]
relationalExpr ::=  rangeExpr [(is | as | isnot) type | ("<" | "<=" | ">" | ">=" | "<=>") rangeExpr]
//typeCheckExpr  ::=  rangeExpr [(is | as | isnot) type]
//compareExpr    ::=  rangeExpr [("<" | "<=" | ">" | ">=" | "<=>") rangeExpr]
rangeExpr      ::=  addExpr ((".." | "..<") addExpr)*
addExpr        ::=  multExpr (("+" | "-") multExpr)*
multExpr         ::=  parenExpr (("*" | "/" | "%") parenExpr)*
parenExpr        ::=  unaryExpr | castExpr | groupedExpr
castExpr       ::=  "(" type ")" parenExpr
groupedExpr    ::=  "(" expr ")" termChain*
unaryExpr      ::=  prefixExpr | termExpr postfixExpr?
prefixExpr     ::=  ("!" | "+" | "-" | "++" | "--") parenExpr
// `left`: wraps the termExpr before it, so termExpr is parsed once (no re-parse
// when there is no ++/--). Compiler: `tokt.isIncrementOrDecrement && !tok.newline`.
left postfixExpr ::=  <<sameLine>> ("++" | "--")

termExpr       ::=  termBase termChain*
termBase       ::=  literal | typeBase | idExpr
typeBase       ::=  typeLiteral | namedSuper | staticCall |
                     dsl | closure | simple | ctorBlock
typeLiteral    ::=   type "#" [<<sameLine>> id] | "#" id
//slotLiteral    ::=  [type] "#" id
namedSuper     ::=  type "." super
staticCall     ::=  type "." slotExpr
dsl            ::=  type DSL_STRING
// Parser.typeBaseExpr: `Type(args)` is a construction call; no newline check, any args.
simple         ::=  type "(" args ")" [closure]
ctorBlock      ::=  type itBlock
termChain      ::=  dotCall | dynCallStm | safeDotCallStm | safeDynCallStm |
                     indexExpr | callOp | itBlock
itBlock        ::=  <<notAccessorBlock>> statementBlock
dotCall        ::=  "." slotExpr
dynCallStm       ::=  dynCall slotExpr
safeDotCallStm   ::=  "?." slotExpr
safeDynCallStm   ::=  safeDynCall slotExpr
idExpr         ::=  local | slotExpr
slotExpr       ::=  field | call
local          ::=  id
field          ::=  ["&"] id
call           ::=  id [<<sameLine>> "(" args ")"] [closure]
args           ::=  [expr ("," expr)*]
// Parser: isIndexOpenBracket / isCallOpenParen require no newline before `[` / `(`.
indexExpr      ::=  <<sameLine>> "[" expr "]"
callOp         ::=  <<sameLine>> "(" args ")" [closure] | closure

literal        ::=  null | this | super | it |
                     bool | INT_LITERAL | FLOAT_LITERAL | DECIMAL_LITERAL | str |
                     DURATION_LITERAL | URI_LITERAL | list | map
bool           ::=  TRUE | FALSE
str            ::=  TRIPLE_STRING_LITERAL | STRING_LITERAL | CHAR_LITERAL
list           ::=  [type] "[" listItems "]"
listItems      ::=  "," | (expr ("," expr)*) [","]
map            ::=  [type] "[" mapItems [","] "]"
mapItems       ::=  ":" | (mapPair ("," mapPair)*)
mapPair        ::=  expr ":" expr

closure        ::=  closureSig statementBlock
closureSig     ::=  "|" closureParams [(dynCall | safeDynCall) [type]] "|"
closureParams  ::=  [closureParam ("," closureParam)*]
// Direct `id` child so FantomClosureParam.getNameIdentifier finds the parameter name.
closureParam   ::=  type id | type | id

//--------------------

// Mirrors Parser.ctype: base, then `?` (no space before it), then any number of
// `[]` each with optional `?`, then `: type` for a map. Only the bracket form
// `[K:V]` is a base; `|...|` is a function type. See docs/engineering/grammar-work.md 5.
type           ::=  nonMapType [mapSuffix]
private nonMapType ::= baseType (nullSuffix | listSuffix)*
private baseType   ::= simpleType | mapType | funcType
private nullSuffix ::= <<noSpaceBefore>> "?"
private listSuffix ::= "[" "]"
private mapSuffix  ::= ":" type
mapType        ::=  "[" nonMapType ":" type "]"
typeList       ::=  type ("," type)*
// `<<typeName>>`: first char uppercase or `_`, or any id followed by `::`.
simpleType     ::=  <<typeName>> id ["::" id]
// `|Obj?->Obj?|` lexes as `Obj` `?->` `Obj`; the compiler (Parser.funcType) accepts
// safeArrow here too and makes the last param nullable. `|->|` has no params and no return.
funcType       ::=  "|" [formals] [(dynCall | safeDynCall) [type]] "|"
formals        ::=  formal ("," formal)*
formal         ::=  formalFull
formalFull     ::=  type [id] | id

//-------------------

id             ::= IDENTIFIER

private dynCall   ::= '->'
private safeDynCall   ::= '?->'
private get       ::= <<getKeyword>>
private set       ::= <<setKeyword>>
//private elvisOp   ::= <<elvisOpImpl>>
