class Foo
{
  Void run(Int tag)
  {
    switch (tag)
    {
      case CP_CLASS:          cpClass[i] = in.readU2
      case CP_FIELD:          skip(4)
      case CP_METHOD:
      case CP_INTERFACE:      skip(4)
      case Key.up:    e.stop; lastEvent=1; select(findPrev(selIndex))
      case opClose:  close; throw IOErr("WebSocket closed")
      case 1:
        x := 1
        echo(x)
      default:
        echo("other")
        return
    }
    switch (tag) { case 1: echo("one") }
    switch (tag) { default: echo("d") }
    switch (tag) {}
  }
}
